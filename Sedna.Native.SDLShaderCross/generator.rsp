--file
../.build/out/include/SDL3_shadercross/SDL_shadercross.h

--output
Generated

--methodClassName
SDL3ShaderCross

--libraryPath
SDL3_shadercross

--headerFile
header.txt

--config
latest-codegen
windows-types
generate-macro-bindings
generate-helper-types
generate-file-scoped-namespaces
multi-file

--include-directory
../.build/out/include

--include-directory
/usr/lib/clang/21/include

--namespace
SDL

--remap
void*=nint
char=byte
wchar_t*=nint
__va_list=byte*
__va_list_tag=byte
Sint64=long
Uint64=ulong

--define-macro
SDL_FUNCTION_POINTER_IS_VOID_POINTER
SDL_SINT64_C(c)=c ## LL
SDL_UINT64_C(c)=c ## ULL
SDL_DECLSPEC=

--additional
--undefine-macro=_WIN32
--undefine-macro=linux
--undefine-macro=__linux
--undefine-macro=__linux__
--undefine-macro=unix
--undefine-macro=__unix
--undefine-macro=__unix__
--undefine-macro=__APPLE__
